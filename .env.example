# ShopMate 电商版 环境变量示例
# 使用方法：复制为 .env，再填入你自己的值
#   cp .env.example .env

# ==================== 大模型（阿里云百炼 DashScope） ====================
API_KEY=sk-your-dashscope-api-key
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.1
LLM_STREAMING=True
LLM_ENABLE_THINKING=False

# ==================== MySQL ====================
# 本地运行用 localhost；Docker 内用 mysql（compose 服务名）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=travel_rag

# ==================== Milvus ====================
# 本地 Milvus standalone 为 localhost；也可填你自己部署的地址
MILVUS_HOST=localhost
MILVUS_PORT=19530
# 电商业务独立库与集合（首次运行 sql/init_product_rag.py 会自动创建）
MILVUS_DB_NAME=ecommerce
MILVUS_COLLECTION=products

# ==================== MCP 服务地址 ====================
PRODUCT_MCP_URL=http://localhost:8001/mcp
RECOMMEND_MCP_URL=http://localhost:8002/mcp
LOGISTICS_MCP_URL=http://localhost:8003/mcp
IMAGE_MCP_URL=http://localhost:8004/mcp
AFTERSALE_MCP_URL=http://localhost:8005/mcp

# ==================== A2A 服务地址 ====================
RECOMMEND_A2A_URL=http://localhost:5005
ORDER_A2A_URL=http://localhost:5006
LOGISTICS_A2A_URL=http://localhost:5007
AFTERSALE_A2A_URL=http://localhost:5008
COPYWRITING_A2A_URL=http://localhost:5009

# ==================== 商品图片检索 ====================
IMAGE_PROVIDER_ORDER=so360,bing
